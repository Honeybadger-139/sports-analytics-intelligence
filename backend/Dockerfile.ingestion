FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir -r requirements-pipeline.txt

COPY src/ ./src/
COPY pipeline/ ./pipeline/

# Default: incremental ESPN sync (safe daily Cloud Scheduler run).
# Override with --mode flush for first-time full 3-season load,
# or --mode backfill for idempotent re-run without truncation.
CMD ["python", "pipeline/run_espn_ingestion.py", "--mode", "incremental"]
