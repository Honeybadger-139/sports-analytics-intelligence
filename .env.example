# PostgreSQL
POSTGRES_DB=sports_analytics
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analytics2026

# Database URL (used by FastAPI backend)
DATABASE_URL=postgresql://analyst:analytics2026@localhost:5432/sports_analytics
CHAT_API_KEY=replace-with-strong-api-key

# Gemini API (Phase 3 — RAG Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
INTELLIGENCE_ENABLED=true
RAG_TOP_K=6
RAG_MAX_AGE_HOURS=120
RAG_CHROMA_DIR=backend/data/chroma
RAG_COLLECTION=nba_context_v1
RAG_SUMMARY_MODEL=gemini-2.0-flash
RAG_EMBEDDING_MODEL=models/embedding-001
RAG_REQUEST_TIMEOUT_SECONDS=8
INTELLIGENCE_SOURCES=https://www.espn.com/espn/rss/nba/news,https://www.cbssports.com/rss/headlines/nba/
INJURY_SOURCES=https://www.rotowire.com/rss/news.php?sport=NBA

# MLOps (Phase 5)
MLOPS_ACCURACY_THRESHOLD=0.55
MLOPS_MAX_BRIER=0.25
MLOPS_NEW_LABEL_MIN=40
MLOPS_FRESHNESS_DAYS=2

# Airflow local orchestration (optional)
# If backend runs on your host machine, keep host.docker.internal.
# If backend runs in Compose, set to http://backend:8000
GAMETHREAD_API_BASE_URL=http://host.docker.internal:8000
GAMETHREAD_CHAT_API_KEY=replace-with-strong-api-key
GAMETHREAD_API_TIMEOUT_SECONDS=7200
GAMETHREAD_PIPELINE_INCLUDE_RAG=false
AIRFLOW_UID=50000
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin

# API-Football (Phase 5 — Football expansion)
# API_FOOTBALL_KEY=your_api_football_key_here

# Frontend dashboard provider (Metabase recommended, Grafana supported)
VITE_DASHBOARD_PROVIDER=metabase
VITE_CHAT_API_KEY=replace-with-strong-api-key

# Metabase (recommended for drag/drop dashboard authoring)
VITE_METABASE_URL=http://localhost:3000
VITE_METABASE_CREATE_PATH=/question/new
VITE_METABASE_LIBRARY_PATH=/collection/root
# Optional: if set, dashboard page opens these directly
VITE_METABASE_DASHBOARD_PREDICTION_ID=
VITE_METABASE_DASHBOARD_PIPELINE_ID=

# Grafana (optional fallback)
VITE_GRAFANA_URL=http://localhost:3301
VITE_GRAFANA_CREATE_PATH=/dashboard/new
VITE_GRAFANA_DASHBOARD_PREDICTION_URL=
VITE_GRAFANA_DASHBOARD_PIPELINE_URL=

# Grafana container (optional; used by docker-compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
